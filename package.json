{
  "name": "admit-route",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "server": "node server/index.js",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:data": "node -e \"import('./shared/data/universities/index.js').then(m=>{m.validateUniversityDatabase();console.log(m.UNIVERSITY_COUNTS)})\"",
    "functions:prepare": "node scripts/prepare-functions.mjs",
    "deploy": "npx firebase-tools deploy --only hosting,functions,firestore",
    "deploy:hosting": "npx firebase-tools deploy --only hosting",
    "deploy:functions": "npx firebase-tools deploy --only functions",
    "secrets:set": "node scripts/set-secrets.mjs",
    "build:hosting": "node scripts/build-hosting.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0",
    "lucide-react": "^1.46.0",
    "nodemailer": "^10.0.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "22.x"
  }
}
